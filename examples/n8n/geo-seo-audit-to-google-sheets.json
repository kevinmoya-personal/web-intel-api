    {
      "parameters": {
        "url": "https://web2agent-clean-markdown-seo-geo-auditor.p.rapidapi.com/api/v1/audit",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "url",
              "value": "={{ $json.url }}"
            }
          ]
        },
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "x-rapidapi-host",
              "value": "web2agent-clean-markdown-seo-geo-auditor.p.rapidapi.com"
            }
          ]
        },
        "options": {
          "batching": {
            "batch": {
              "batchSize": 1,
              "batchInterval": 1500
            }
          },
          "timeout": 30000
        }
      },
      "id": "30c20cf1-60be-48e0-9f2b-39e1ef7066b6",
      "name": "Audit site (Web2Agent)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        300,
        100
      ],
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "jsCode": "// Pair every API response with the URL that was requested (same order)\nconst sites = $('Read site list').all();\nreturn $input.all().map((item, i) => {\n  const r = item.json || {};\n  const url = sites[i]?.json?.url || r.url || '';\n  if (!r.success) {\n    return { json: { url, checked_at: new Date().toISOString(), score: '', grade: 'ERROR',\n      issues_count: '', has_llms_txt: '', ai_bots_blocked: '', top_issues: r.error || r.message || 'Request failed' } };\n  }\n  const a = r.audit || {};\n  const ai = a.aiReadiness || {};\n  const rank = { high: 0, medium: 1, low: 2, info: 3 };\n  const top = (a.issues || [])\n    .sort((x, y) => (rank[x.severity] ?? 9) - (rank[y.severity] ?? 9))\n    .slice(0, 5)\n    .map(x => `[${x.severity}] ${x.category}: ${x.message}`)\n    .join('\\n');\n  return { json: {\n    url,\n    checked_at: new Date().toISOString(),\n    score: a.overallScore,\n    grade: a.grade,\n    issues_count: a.issuesCount,\n    has_llms_txt: ai.hasLlmsTxt ? 'yes' : 'no',\n    ai_bots_blocked: (ai.blockedBots || []).join(', ') || 'none',\n    top_issues: top,\n  } };\n});"
      },
